# Frontend Vite Environment Example
# Copy to .env and adjust as needed.

# Core API base (versioned)
VITE_API_BASE=/api/v1

# Specialized service bases (override only if different)
VITE_CLASSIFICATION_BASE=/api/v1/classification
VITE_PREDICTION_BASE=/api/v1/prediction
VITE_SUMMARIZATION_BASE=/api/v1/summarization
VITE_CHAT_BASE=/api/v1/chat
VITE_DRAFTING_BASE=/api/v1/drafting
VITE_LEASE_AGREEMENTS_BASE=/api/v1/lease_agreements

# Optional client management override (was previously the only env-based one)
# VITE_CLIENTS_API_URL=/api/v1

# Example for future multi-tenant or feature flags
# VITE_FEATURE_LEASE_AGREEMENTS=true
